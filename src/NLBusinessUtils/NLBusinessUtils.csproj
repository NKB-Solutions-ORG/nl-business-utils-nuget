<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>NLBusinessUtils</PackageId>
    <Description>Validation and formatting utilities for Dutch business identifiers: BSN, RSIN, KVK-nummer, vestigingsnummer, BTW-nummer (VAT), loonheffingennummer, IBAN, postcode, phone numbers and euro amounts.</Description>
    <PackageTags>bsn;rsin;kvk;vestigingsnummer;btw;vat;loonheffingennummer;iban;postcode;netherlands;dutch;validation;elfproef</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
